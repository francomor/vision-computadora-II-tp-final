def paneles(fila, q):
    """gt | prediccion, sobre la fisheye"""
    img = cv2.imread(str(fila.ruta))
    m = q["conf"] >= CONF_VIS
    return [dibujar(img, fila.gt_cajas, fila.gt_clases), dibujar(img, q["cajas"][m], q["clases"][m], q["conf"][m])]


